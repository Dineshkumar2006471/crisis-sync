rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function staffDoc(userId) {
      return get(/databases/$(database)/documents/staff/$(userId));
    }

    function hasStaffProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function requesterHotelId() {
      return hasStaffProfile() ? staffDoc(request.auth.uid).data.hotel_id : null;
    }

    function requesterRole() {
      return hasStaffProfile() ? staffDoc(request.auth.uid).data.role : null;
    }

    function isAdminOrManagement() {
      return requesterRole() in ['admin', 'management'];
    }

    function sameHotel(resourceHotelId) {
      return hasStaffProfile() && requesterHotelId() == resourceHotelId;
    }

    match /staff/{userId} {
      allow read: if isSelf(userId) || isAdminOrManagement() || sameHotel(resource.data.hotel_id);
      allow create: if isSelf(userId)
        && request.resource.data.email is string
        && request.resource.data.display_name is string
        && request.resource.data.hotel_id is string
        && request.resource.data.role in ['front_desk', 'security', 'housekeeping']
        && request.resource.data.active == false;
      allow update: if (
        isSelf(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.hotel_id == resource.data.hotel_id
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.created_at == resource.data.created_at
      ) || isAdminOrManagement();
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow create: if isSignedIn()
        && request.resource.data.hotel_id is string
        && request.resource.data.raw_text is string
        && request.resource.data.status in ['reported', 'acknowledged', 'responding', 'resolved'];

      allow read: if isSignedIn() && (
        sameHotel(resource.data.hotel_id)
        || isAdminOrManagement()
      );

      allow update: if isSignedIn() && (
        sameHotel(resource.data.hotel_id)
        || isAdminOrManagement()
      );

      allow delete: if isSignedIn() && isAdminOrManagement();
    }

    match /logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.hotelId is string
        && request.resource.data.incidentId is string
        && request.resource.data.action is string;

      allow read: if isSignedIn() && (
        sameHotel(resource.data.hotelId)
        || isAdminOrManagement()
      );

      allow update, delete: if false;
    }
  }
}
